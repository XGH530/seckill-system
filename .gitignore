# ===== 构建产物 =====
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ===== 日志 =====
*.log
logs/
# 例外：保留压测过程记录（作为实测证据）
!pressure-test/*.log

# ===== IDE =====
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 压测运行产物 =====
# 保留 .java 源码与结果证据文件，忽略编译输出、调试日志与临时探测文件
pressure-test/out/
pressure-test/*.class
pressure-test/app-run*.log
pressure-test/probe*.txt
/tmp/

# ===== JMeter 压测产物 =====
# 保留 jtl 原始数据与 jmx 计划（简历"实测"声明的证据链，面试可现场复跑/生成报告）
# 不提交：压测用户 token 文件、HTML 报告目录（内含 250+ 第三方前端文件，可用 jtl 现场生成）
jmeter/*_users.csv
jmeter/users*.csv
jmeter/*.log
jmeter/report_*/
jmeter/*_report/
jmeter/result.jtl
jmeter/result_*.jtl

# ===== 本地环境配置（含密钥/本机路径，不入库）=====
application-local.yml
application-dev.yml
*.local.yml
.env
